# -----------------------------------------------------------------------------
# おたよりカレンダー (Otayori Calendar) 環境変数定義例
# 本番デプロイ（Vercel）およびローカル開発（.env.local）に設定してください。
# ※セキュリティのため、実際のシークレットキーは決してコミットしないでください。
# -----------------------------------------------------------------------------

# ① App / Next.js 設定
NEXT_PUBLIC_APP_URL="https://your-app-domain.vercel.app"

# ② Google Gemini API キー
GEMINI_API_KEY="AIzaSy..."

# ③ Firebase サーバーサイド認証 (Firebase Admin SDK サービスアカウント JSON)
# Vercelには改行を除去した1行のJSON文字列として貼り付けてください。
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# ④ Firebase フロントエンド（クライアントサイド）用の設定キー
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef..."
NEXT_PUBLIC_FIREBASE_VAPID_KEY="Bxxxxx..." # Firebase ConsoleのCloud Messagingで生成したウェブプッシュ鍵ペア (通知用)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX" # Google Analytics 4 測定ID (効果測定用)

# ⑤ Stripe 決済設定 (本番用/テスト用)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRICE_ID="price_..." # Stripeダッシュボードで登録したサブスクリプション商品の価格ID (月額480円プラン等)

# ⑥ Sentry エラー監視設定
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# Vercelビルド時自動ソースマップアップロード用トークン (任意)
SENTRY_AUTH_TOKEN="sntryu_..."

# ⑦ Resend トランザクションメール送信設定
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev" # 無料枠用。カスタムドメイン設定後は info@yourdomain.com 等に変更可能

# ⑧ Google AdSense 設定 (任意)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-..."
