rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー個人のプロファイル制限
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // groups/{groupId}/events 配下の予定データも、そのグループに所属するユーザーのみアクセス可能
    match /groups/{groupId}/events/{eventId} {
      // 1. groupId が自分自身の uid と一致する場合は、プロファイルの存在に関わらず無条件で許可 (高速パススルー・初期 Permission Denied 回避)
      // 2. groupId が異なる (家族シェア連携時) の場合は、プロファイル存在を確認したうえで groupId が一致するか確認 (exists() ガード)
      allow read: if request.auth != null && (
        request.auth.uid == groupId || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId
        )
      );
      
      // 書き込み制限（パターンB）: カレンダー所有者本人は常に書き込み可能。共有された側は、所有者がプレミアム会員の場合のみ書き込み（追加・編集・削除）を許可
      allow write: if request.auth != null && (
        request.auth.uid == groupId || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == groupId &&
          get(/databases/$(database)/documents/users/$(groupId)).data.plan == 'premium'
        )
      );
    }
    
    // reminders コレクション（ルート階層）に対する制限
    match /reminders/{reminderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
